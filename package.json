{
    "name": "janus",
    "private": true,
    "workspaces": [
        "packages/*",
        "apps/*",
        "services/*"
    ],
    "scripts": {
        "build:ui": "bun run --filter @janus/ui build",
        "dev:ui": "bun run --filter @janus/ui dev",
        "dev:ios": "bun scripts/dev-ios.ts",
        "dev:desktop": "bun scripts/dev-desktop.ts",
        "desktop:prod": "bun run build:ui && bun run --filter @janus/desktop start",
        "desktop:package": "bun run build:ui && bun run --filter @janus/desktop build && bun run --filter @janus/desktop package",
        "test": "vitest run",
        "lint": "oxlint .",
        "cap:sync:ios": "bun run build:ui && bun apps/mobile/scripts/prepare-cap-web.ts && bun run --filter @janus/mobile cap:sync",
        "cap:open:ios": "bun run --filter @janus/mobile cap:open",
        "validate:install": "bun scripts/validate-install.ts",
        "validate:desktop-release": "bun scripts/validate-desktop-release.ts",
        "ensure:electron": "bun scripts/ensure-electron.ts",
        "ensure:esbuild": "bun scripts/ensure-esbuild.ts",
        "postinstall": "bun scripts/ensure-esbuild.ts"
    },
    "devDependencies": {
        "@types/node": "22.10.2",
        "happy-dom": "15.11.7",
        "oxlint": "0.15.0",
        "typescript": "5.7.2",
        "vitest": "2.1.8"
    }
}
