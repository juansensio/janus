{
    "name": "@janus/desktop",
    "version": "0.1.1",
    "private": true,
    "type": "module",
    "main": "dist/main.js",
    "scripts": {
        "build": "bun build src/main.ts --outdir dist --target node --external electron && bun build src/preload.ts --outdir dist --format cjs --external electron",
        "prestart": "bun ../../scripts/ensure-electron.ts",
        "start": "bun run build && electron .",
        "package": "electron-builder --mac"
    },
    "build": {
        "appId": "com.janus.writer",
        "productName": "Janus",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*"
        ],
        "extraResources": [
            {
                "from": "../../dist/ui",
                "to": "ui"
            }
        ],
        "mac": {
            "target": [
                "zip",
                "dmg"
            ],
            "category": "public.app-category.productivity"
        },
        "npmRebuild": false,
        "nodeGypRebuild": false,
        "afterPack": "./scripts/after-pack-adhoc-sign.cjs"
    },
    "dependencies": {},
    "devDependencies": {
        "@janus/bridge": "workspace:*",
        "@janus/languages": "workspace:*",
        "@janus/library": "workspace:*",
        "@janus/manuscript": "workspace:*",
        "electron": "33.2.1",
        "electron-builder": "25.1.8"
    }
}
